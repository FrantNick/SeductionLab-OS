# PostgreSQL connection string
DATABASE_URL="postgresql://seductionlab:seductionlab@localhost:5432/seductionlab"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-random-secret"
AUTH_TRUST_HOST="true"

# Public URL of the app (used to build tracking links, e.g. https://go.seduction-lab.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional dedicated tracking-link domain (falls back to NEXT_PUBLIC_APP_URL)
TRACKING_DOMAIN="http://localhost:3000"

# Salt used when hashing click IP addresses (privacy)
IP_HASH_SALT="change-me-random-salt"

# Apify — token for the goat255/twitter-tweet-scraper actor.
# Leave empty to disable scraping (thread submission still works).
APIFY_TOKEN=""
APIFY_ACTOR_ID="goat255~twitter-tweet-scraper"

# Shared secret protecting the /api/cron/* job endpoints
CRON_SECRET="change-me-cron-secret"

# Seed credentials (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@seduction-lab.com"
SEED_ADMIN_PASSWORD="admin12345"
# Set to "true" to also seed demo affiliates/campaigns/metrics
SEED_DEMO_DATA="true"
